# ──────────────────────────────────────────────────────────────────────────────
# Inbound AI Voice Call Centre — environment template
#
# This file is for LOCAL DEVELOPMENT ONLY. In production (VPS / Coolify), real
# environment variables on the host are the single source of truth.
#
# To make the Python processes read this file, you must explicitly opt in:
#     export OUTBOUNDAI_LOAD_DOTENV=true
# Without that flag, .env is ignored — exactly as it will be in production.
# Even when enabled, .env values NEVER override variables already set on the
# host (load_dotenv is called with override=False).
#
# Note: OUTBOUNDAI_LOAD_DOTENV must be set in your shell BEFORE running the
# app (not inside this file), e.g. on Linux/macOS:
#   export OUTBOUNDAI_LOAD_DOTENV=true && bash start.sh
# ──────────────────────────────────────────────────────────────────────────────

# ════════════════ REQUIRED — the app will not start without these ════════════

# ── LiveKit Cloud ── cloud.livekit.io → Project → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Google Gemini (voice AI brain) ── aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_VOICE=Aoede
USE_GEMINI_REALTIME=true
GOOGLE_PROJECT_NUMBER=

# ── Supabase (call logs, leads, agent profiles) ── supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_PASSWORD=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Inbound SIP trunk (LiveKit) ──
# The LiveKit INBOUND SIP trunk ID (starts with ST_). Create it from the
# dashboard Settings tab (⚡ Create SIP Trunk) or run: python create_trunk.py
INBOUND_TRUNK_ID=

# ── Vobiz SIP telephony ── vobiz.ai (the phone number callers dial)
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=your_username
VOBIZ_PASSWORD=your_password
VOBIZ_INBOUND_NUMBER=

# ════════════════ RECOMMENDED for the TextileProjects.in flow ════════════════

# ── Cal.com (consultant booking — needed for the consultation pitch) ──
# cal.com → Settings → Developer → API Keys; event type ID from the event URL.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_TIMEZONE=Asia/Kolkata

# ── Lead CSV capture ──
# Where caller answers (qualification, budget, mobile, email…) are saved.
# In Coolify, mount a persistent volume (e.g. /data) and point this at it,
# otherwise the CSV is wiped on every redeploy.
LEAD_CSV_PATH=/data/leads.csv

# ── Human transfer ──
# Number dialled when the caller asks for a human agent.
DEFAULT_TRANSFER_NUMBER=

# ════════════════ OPTIONAL ═══════════════════════════════════════════════════

# ── S3 / Supabase Storage (call recordings) ──
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=

# ── Twilio SMS (confirmation texts) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Deepgram (pipeline fallback STT if Gemini realtime is disabled) ──
DEEPGRAM_API_KEY=

PORT=8000
